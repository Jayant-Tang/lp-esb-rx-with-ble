/* nRF54L15DK: console is on uart20 (TX=P1.4, RX=P1.5) */
&uart20 {
    status = "okay";
    zephyr,pm-device-runtime-auto;
    /delete-property/ hw-flow-control;
};

/* Remove RTS/CTS pins from the default pinctrl group */
&uart20_default {
    group1 {
        psels = <NRF_PSEL(UART_TX, 1, 4)>;
    };
    group2 {
        psels = <NRF_PSEL(UART_RX, 1, 5)>;
        bias-pull-up;
    };
};

&uart20_sleep {
    group1 {
        psels = <NRF_PSEL(UART_TX, 1, 4)>,
            <NRF_PSEL(UART_RX, 1, 5)>;
        low-power-enable;
        bias-pull-up;
    };
};
