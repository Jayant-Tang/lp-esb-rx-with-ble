config APP_ESB_MPSL_TIMESLOT_RX_INTERVAL_US
	int "ESB PRX MPSL listen interval (us)"
	default 0
	help
	  Interval between ESB PRX listen windows in microseconds.
	  When non-zero, the patched ESB PRX path requests MPSL NORMAL
	  timeslots at this fixed interval instead of continuously requesting
	  EARLIEST timeslots.

config APP_ESB_MPSL_TIMESLOT_RX_WINDOW_US
	int "ESB PRX MPSL listen window (us)"
	default 0
	help
	  Approximate duration of each ESB PRX listen window in microseconds.
	  The patched ESB PRX path limits timeslot extensions to approximate
	  this window length. Set to 0 to keep upstream ESB behavior.

module = APP_ESB
module-str = app-esb
source "subsys/logging/Kconfig.template.log_config"
